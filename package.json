{
  "name": "projector",
  "version": "0.1.0",
  "description": "Projection mapping video player for walls with masked-out areas",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npx --yes @electron/packager@18 . Projector --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=com.oozou.projector --icon=build/icon.icns --extend-info=build/Info.extend.plist --app-version=0.1.0 --ignore='^/(dist|build/icon.iconset|\\.git)' --prune=true",
    "fetch-models": "sh scripts/fetch-models.sh",
    "build:css": "npx --yes tailwindcss@3 -c tailwind.config.js -i src/remote/tw.input.css -o src/remote/tw.css --minify"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.2.2"
  },
  "author": "constantin",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
